# Copy to .env. Never commit .env.
# Secrets have no defaults on purpose: a missing key must fail at startup,
# not at the first AI call during a demo.

ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://ledgergraph:ledgergraph@localhost:5432/ledgergraph
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Four accounts, one per role, so the RBAC boundary can be demonstrated.
# The API refuses to create them when ENVIRONMENT=production - the
# password is published in the README, which makes them an open door
# rather than a convenience there.
SEED_DEMO_USERS=true
DEMO_PASSWORD=ledgergraph-demo-2026

FRONTEND_ORIGIN=http://localhost:3000

BUSINESS_TIMEZONE=Asia/Kolkata
BASE_CURRENCY=INR

# ---------------------------------------------------------------------------
# AI investigation. Optional - the engine is fully functional with this off,
# and every deterministic finding stands without it.
#
# The only capability required is schema-constrained JSON output. Pick
# whichever provider you have access to; see docs/02-tech-stack.md section 6.
#
#   gemini             free tier, no card. Default. Set AI_MODEL to a Flash
#                      model - the Pro models are not on the free tier.
#                      Key: aistudio.google.com/apikey
#   groq               free tier, no card. Fast. Use a model that supports
#                      strict json_schema, not just JSON mode.
#                      Key: console.groq.com/keys
#   openai_compatible  anything speaking the OpenAI schema (Cerebras,
#                      OpenRouter, Together, vLLM). Requires AI_BASE_URL.
#   ollama             local, no key, no network. Requires AI_BASE_URL.
# ---------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
# AI_BASE_URL=http://localhost:11434/v1

# Which Repository implementation to install: memory | postgres.
# Explicit on purpose - auto-detecting from DATABASE_URL would let a blip
# at boot silently downgrade a deployment to a non-durable store that
# accepts every write and loses it. Refused in production.
PERSISTENCE=memory
