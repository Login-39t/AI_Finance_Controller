# Copy to .env. Never commit .env.
# Secrets have no defaults on purpose: a missing key must fail at startup,
# not at the first AI call during a demo.

DATABASE_URL=postgresql+asyncpg://ledgergraph:ledgergraph@localhost:5432/ledgergraph
ANTHROPIC_API_KEY=
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Kolkata
BASE_CURRENCY=INR
